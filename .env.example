# Copy to a private environment file or export variables in the host shell.
# Do not commit real credentials and do not paste them into chat.
UNEXPECTED_PROVIDER=mock
UNEXPECTED_BASE_URL=
UNEXPECTED_MODEL=
UNEXPECTED_API_KEY=
UNEXPECTED_STATE_DIR=./state
UNEXPECTED_MAX_WORKERS=4
UNEXPECTED_MAX_RETRIES=1
UNEXPECTED_DEFAULT_TIMEOUT_SECONDS=30

# Optional real-model connection through the existing AI Studio gateway.
# Provider API keys remain in the Node gateway; this runtime receives only its bearer token.
# Keep mock as the default for tests; enable explicitly in the host secret manager.
# UNEXPECTED_PROVIDER=ai_studio_gateway
# UNEXPECTED_GATEWAY_URL=https://unexpected-ai-studio.onrender.com/orchestrate
# UNEXPECTED_GATEWAY_MODE=openai
# UNEXPECTED_GATEWAY_TOKEN=
# UNEXPECTED_GATEWAY_TIMEOUT_SECONDS=200

# Optional HTTP API. Use a different random token of at least 32 characters.
# Without it, private routes remain locked.
# UNEXPECTED_RUNTIME_API_TOKEN=

# Optional evidence adapters. Leave unset to fail closed when a task needs these checks.
# Render Sandboxes create disposable microVMs with outbound network denied.
# Add RENDER_API_KEY and RENDER_WORKSPACE_ID only in the runtime host secret manager.
# Never inject these values into the sandbox or commit them.
# UNEXPECTED_TEST_EXECUTOR=render-sandbox
# UNEXPECTED_TEST_SANDBOX_TIMEOUT_SECONDS=300
# RENDER_API_KEY=
# RENDER_WORKSPACE_ID=

# Optional CI/self-hosted test backend. The image reference must include an immutable sha256 digest.
# UNEXPECTED_TEST_EXECUTOR=docker
# UNEXPECTED_TEST_DOCKER_IMAGE=python:3.12-slim-bookworm@sha256:<verified-digest>
# UNEXPECTED_TEST_WORKSPACE_ROOT=.
# UNEXPECTED_TEST_TIMEOUT_SECONDS=180

# Independent lifecycle reviewer. Configure a distinct provider route from the primary.
# Example: primary gateway mode=openai, reviewer gateway mode=claude.
# Dedicated token is optional when the AI Studio gateway token is already configured.
UNEXPECTED_REVIEW_PROVIDER=ai_studio_gateway
UNEXPECTED_REVIEW_GATEWAY_MODE=claude
# UNEXPECTED_REVIEW_GATEWAY_TOKEN=
# UNEXPECTED_REVIEW_GATEWAY_URL=
# UNEXPECTED_REVIEW_GATEWAY_TIMEOUT_SECONDS=200
# Alternative separate OpenAI-compatible reviewer:
# UNEXPECTED_REVIEW_PROVIDER=openai_compatible
# UNEXPECTED_REVIEW_BASE_URL=https://review-provider.example/v1
# UNEXPECTED_REVIEW_MODEL=review-model
# UNEXPECTED_REVIEW_API_KEY=
# UNEXPECTED_REVIEW_TIMEOUT_SECONDS=60

# Trusted HTTPS source retrieval. Only exact hostnames are accepted; no wildcard domains.
# UNEXPECTED_SOURCE_ALLOWED_DOMAINS=docs.python.org
# UNEXPECTED_SOURCE_TIMEOUT_SECONDS=8
# UNEXPECTED_SOURCE_MAX_BYTES=262144
# UNEXPECTED_SOURCE_MAX_COUNT=3

# GitHub approval verifier: read-only token; never commit it.
UNEXPECTED_GITHUB_APPROVAL_TOKEN=
UNEXPECTED_GITHUB_APPROVAL_REPOSITORY=soueilouay-creator/uneXpected-
# Exact comma-separated owner/repo allowlist; target repository must be a member.
UNEXPECTED_GITHUB_APPROVAL_ALLOWED_REPOSITORIES=
UNEXPECTED_GITHUB_APPROVAL_TRUSTED_REVIEWERS=
UNEXPECTED_GITHUB_APPROVAL_BASE_BRANCH=main
UNEXPECTED_GITHUB_APPROVAL_MAX_AGE_SECONDS=3600
UNEXPECTED_GITHUB_APPROVAL_TIMEOUT_SECONDS=8
UNEXPECTED_APPROVAL_LEDGER_PATH=./state/approval-ledger.sqlite3
