# Copy to a private environment file or export variables in the host shell.
# Do not commit real credentials and do not paste them into chat.
UNEXPECTED_PROVIDER=mock
UNEXPECTED_BASE_URL=
UNEXPECTED_MODEL=
UNEXPECTED_API_KEY=
UNEXPECTED_STATE_DIR=./state
UNEXPECTED_STORAGE_BACKEND=sqlite
# Set to postgres only after migration 002 has been tested and applied.
# DATABASE_URL=

# Native v8 provider routes. Credentials stay in the host secret manager.
UNEXPECTED_DEFAULT_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OpenOx native Responses API route. The router remains on mock until a key is present.
# OPENOX_API_KEY=
# OPENOX_BASE_URL=https://api.openoxai.com/v1
# OPENOX_MODEL=gpt-6-astra
UNEXPECTED_MAX_WORKERS=4
UNEXPECTED_MAX_RETRIES=1
UNEXPECTED_DEFAULT_TIMEOUT_SECONDS=30

# Optional real-model connection through the existing AI Studio gateway.
# Provider API keys remain in the Node gateway; this runtime receives only its bearer token.
# Keep mock as the default for tests; enable explicitly in the host secret manager.
# UNEXPECTED_PROVIDER=ai_studio_gateway
# UNEXPECTED_GATEWAY_URL=https://unexpected-ai-studio.onrender.com/orchestrate
# UNEXPECTED_GATEWAY_MODE=openai
# UNEXPECTED_GATEWAY_TOKEN=
# UNEXPECTED_GATEWAY_TIMEOUT_SECONDS=200

# Optional HTTP API. Use a different random token of at least 32 characters.
# Without it, private routes remain locked.
# UNEXPECTED_RUNTIME_API_TOKEN=

# GitHub approval verifier: read-only token; never commit it.
UNEXPECTED_GITHUB_APPROVAL_TOKEN=
UNEXPECTED_GITHUB_APPROVAL_REPOSITORY=soueilouay-creator/uneXpected-
# Exact comma-separated owner/repo allowlist; target repository must be a member.
UNEXPECTED_GITHUB_APPROVAL_ALLOWED_REPOSITORIES=
UNEXPECTED_GITHUB_APPROVAL_TRUSTED_REVIEWERS=
UNEXPECTED_GITHUB_APPROVAL_BASE_BRANCH=main
UNEXPECTED_GITHUB_APPROVAL_MAX_AGE_SECONDS=3600
UNEXPECTED_GITHUB_APPROVAL_TIMEOUT_SECONDS=8
UNEXPECTED_APPROVAL_LEDGER_PATH=./state/approval-ledger.sqlite3
# When storage is postgres, set UNEXPECTED_APPROVAL_LEDGER_BACKEND=postgres after migration and recovery tests.
# UNEXPECTED_APPROVAL_LEDGER_BACKEND=postgres

# Optional local OpenFilm worker. Keep this unset until the host is reviewed and tested.
# The worker is a one-job process in this same uneXpected installation, not a public service.
# UNEXPECTED_OPENFILM_PODMAN_PATH=/usr/bin/podman
# Use the immutable local Podman image ID printed by: podman image inspect --format '{{.Id}}' localhost/uneXpected-openfilm-worker:0.2.7
# UNEXPECTED_OPENFILM_WORKER_IMAGE=sha256:<64-lowercase-hex>
# Host ceilings enforced by rootless Podman + cgroup v2.
# UNEXPECTED_OPENFILM_HOST_MAX_MEMORY_BYTES=3221225472
# UNEXPECTED_OPENFILM_HOST_MAX_CPU_LIMIT=1.5
# UNEXPECTED_OPENFILM_HOST_MAX_PIDS=128
# UNEXPECTED_OPENFILM_HOST_TMPFS_BYTES=1073741824
# Worker job limits (must not exceed the host ceilings above).
# UNEXPECTED_OPENFILM_WORKER_ID=local-openfilm-worker
# UNEXPECTED_OPENFILM_PROJECT_ROOT=/absolute/path/to/openfilm-projects
# UNEXPECTED_OPENFILM_ARTIFACT_ROOT=/absolute/path/to/openfilm-artifacts
# UNEXPECTED_OPENFILM_TIMEOUT_SECONDS=600
# UNEXPECTED_OPENFILM_LEASE_SECONDS=660
# UNEXPECTED_OPENFILM_MAX_PROJECT_BYTES=52428800
# UNEXPECTED_OPENFILM_MAX_ASSET_COUNT=200
# UNEXPECTED_OPENFILM_MAX_FILE_BYTES=10485760
# UNEXPECTED_OPENFILM_MAX_OUTPUT_BYTES=524288000
# UNEXPECTED_OPENFILM_MEMORY_BYTES=1073741824
# UNEXPECTED_OPENFILM_CPU_LIMIT=1.0
# UNEXPECTED_OPENFILM_PIDS_LIMIT=64
# UNEXPECTED_OPENFILM_TMPFS_BYTES=268435456
# UNEXPECTED_OPENFILM_FFPROBE_PATH=/usr/bin/ffprobe
# UNEXPECTED_OPENFILM_FFMPEG_PATH=/usr/bin/ffmpeg
# UNEXPECTED_OPENFILM_QA_TIMEOUT_SECONDS=120
